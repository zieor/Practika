<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="victorina.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:victorina"
    xmlns:local="clr-namespace:victorina"
    Title="victorina">

    <ShellContent
        Title="Описание сложностей"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
  
    
    <FlyoutItem Title="Сложность">
        <ShellContent Route="Level1" ContentTemplate="{DataTemplate pages:Level1}" />
    </FlyoutItem>

</Shell>
